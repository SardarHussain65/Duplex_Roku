<?xml version="1.0" encoding="utf-8" ?>
<component name="XtreamSetupPanel" extends="Group">
  <interface>
    <field id="backSelected" type="boolean" alwaysNotify="true" />
    <field id="playlistCreated" type="assocarray" alwaysNotify="true" />
    <function name="onPanelShown" />
    <function name="handleKeyEvent" />
  </interface>

  <children>
    <Rectangle id="background" width="1920" height="1080" color="0x141416FF" />

    <Group id="contentRoot" translation="[500, 40]">
      <Group id="headerGroup">
        <Poster id="logo" translation="[420, 0]" uri="pkg:/images/logo.png" width="80" height="80" loadDisplayMode="scaleToFit" />

        <Rectangle id="pillBg" translation="[110, 96]" width="700" height="44" color="0x1C1E24FF" />
        <Rectangle id="pillBorder" translation="[110, 96]" width="700" height="44" color="0x353945FF" />
        <Label id="pillMac" translation="[130, 106]" width="300" height="28" text="MAC Address: 02:00:00:00:00:00" />
        <Rectangle id="pillDivider" translation="[440, 110]" width="1" height="16" color="0x353945FF" />
        <Label id="pillKey" translation="[460, 106]" width="320" height="28" text="Device Key: N/A" />

        <Rectangle id="tabsBg" translation="[0, 168]" width="920" height="68" color="0x1C1E24FF" />
        <Group id="tabXc" translation="[6, 174]">
          <Rectangle id="tabXcBg" width="452" height="56" color="0x23262FFF" />
          <Label id="tabXcText" translation="[0, 14]" width="452" height="32" horizAlign="center" text="Xtream Codes" />
        </Group>
        <Group id="tabUrl" translation="[462, 174]">
          <Rectangle id="tabUrlBg" width="452" height="56" color="0x00000001" />
          <Label id="tabUrlText" translation="[0, 14]" width="452" height="32" horizAlign="center" text="Playlist URL" />
        </Group>

        <Label id="title" translation="[0, 260]" width="920" height="48" horizAlign="center" text="Add Xtream Codes Playlist" />
        <Label
          id="subtitle"
          translation="[60, 314]"
          width="800"
          height="60"
          horizAlign="center"
          wrap="true"
          maxLines="2"
          text="Enter your Xtream Codes server details to add a new playlist." />
      </Group>

      <Group id="formRoot" translation="[0, 390]">
        <Label id="label0" translation="[0, 0]" width="920" height="28" text="Playlist Name" />
        <Rectangle id="input0Ring" translation="[-3, 29]" width="926" height="70" color="0x00000001" visible="false" />
        <Rectangle id="input0Bg" translation="[0, 32]" width="920" height="64" color="0x1C1E24FF" />
        <Label id="input0" translation="[20, 48]" width="880" height="32" text="Enter playlist name" />

        <Label id="label1" translation="[0, 112]" width="920" height="28" text="Server DNS" />
        <Rectangle id="input1Ring" translation="[-3, 141]" width="926" height="70" color="0x00000001" visible="false" />
        <Rectangle id="input1Bg" translation="[0, 144]" width="920" height="64" color="0x1C1E24FF" />
        <Label id="input1" translation="[20, 160]" width="880" height="32" text="http://example.com:8080" />

        <Label id="label2" translation="[0, 224]" width="920" height="28" text="Username" />
        <Rectangle id="input2Ring" translation="[-3, 253]" width="926" height="70" color="0x00000001" visible="false" />
        <Rectangle id="input2Bg" translation="[0, 256]" width="920" height="64" color="0x1C1E24FF" />
        <Label id="input2" translation="[20, 272]" width="880" height="32" text="Enter username" />

        <Label id="label3" translation="[0, 336]" width="920" height="28" text="Password" />
        <Rectangle id="input3Ring" translation="[-3, 365]" width="926" height="70" color="0x00000001" visible="false" />
        <Rectangle id="input3Bg" translation="[0, 368]" width="920" height="64" color="0x1C1E24FF" />
        <Label id="input3" translation="[20, 384]" width="880" height="32" text="Enter password" />
      </Group>

      <Label id="errorLabel" translation="[0, 780]" width="920" height="32" horizAlign="center" visible="false" text="" />

      <Group id="actionsRoot" translation="[0, 820]">
        <Group id="cancelBtn" translation="[0, 0]">
          <Rectangle id="cancelBg" width="440" height="64" color="0x1C1E24FF" />
          <Label id="cancelText" translation="[0, 18]" width="440" height="32" horizAlign="center" text="Cancel" />
        </Group>
        <Group id="confirmBtn" translation="[480, 0]">
          <Rectangle id="confirmBg" width="440" height="64" color="0x353945FF" />
          <Label id="confirmText" translation="[0, 18]" width="440" height="32" horizAlign="center" text="Confirm" />
        </Group>
      </Group>
    </Group>

    <Group id="keyboardHeader" translation="[500, 48]" visible="false">
      <Label id="kbFieldLabel" width="920" height="28" text="Playlist Name" />
      <Rectangle id="kbFieldBg" translation="[0, 36]" width="920" height="64" color="0x1C1E24FF" />
      <Label id="kbFieldValue" translation="[20, 52]" width="880" height="32" text="" />
    </Group>

    <Group id="keyboardRoot" translation="[500, 560]" visible="false" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/DuplexShared.brs" />
  <script type="text/brightscript" uri="pkg:/source/widgets/DuplexKeyboard.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/XtreamSetupPanel.brs" />
</component>
