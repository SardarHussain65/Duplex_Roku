<?xml version="1.0" encoding="utf-8" ?>
<component name="XtreamSetupPanel" extends="Group">
  <interface>
    <field id="backSelected" type="boolean" alwaysNotify="true" />
    <field id="playlistCreated" type="assocarray" alwaysNotify="true" />
    <function name="onPanelShown" />
    <function name="handleKeyEvent" />
  </interface>

  <children>
    <Rectangle id="background" width="1920" height="1080" color="0x141416FF" />

    <!-- 920px column centered → x = 500 -->
    <Group id="contentRoot" translation="[500, 24]">
      <Group id="headerGroup">
        <Poster id="logo" translation="[420, 0]" uri="pkg:/images/logo.png" width="72" height="72" loadDisplayMode="scaleToFit" />

        <!-- Identity pill -->
        <Poster id="pillBg" translation="[110, 84]" width="700" height="44" uri="pkg:/images/ui/xtream-pill.png" loadDisplayMode="scaleToFit" />
        <Label id="pillMac" translation="[130, 94]" width="300" height="28" text="MAC Address: DPX - 02000000" />
        <Rectangle id="pillDivider" translation="[440, 98]" width="1" height="16" color="0x353945FF" />
        <Label id="pillKey" translation="[460, 94]" width="320" height="28" text="Device Key: N/A" />

        <!-- Tabs -->
        <Poster id="tabsTrack" translation="[0, 144]" width="920" height="68" uri="pkg:/images/ui/xtream-tabs-track.png" loadDisplayMode="scaleToFit" />
        <Group id="tabXc" translation="[8, 150]">
          <Poster id="tabXcBg" width="452" height="56" uri="pkg:/images/ui/xtream-tab-active.png" loadDisplayMode="scaleToFit" />
          <Label id="tabXcText" translation="[0, 14]" width="452" height="32" horizAlign="center" text="Xtream Codes" />
        </Group>
        <Group id="tabUrl" translation="[460, 150]">
          <Poster id="tabUrlBg" width="452" height="56" uri="pkg:/images/ui/xtream-tab-idle.png" loadDisplayMode="scaleToFit" />
          <Label id="tabUrlText" translation="[0, 14]" width="452" height="32" horizAlign="center" text="Playlist URL" />
        </Group>

        <Label id="title" translation="[0, 228]" width="920" height="44" horizAlign="center" text="Add Xtream Codes Playlist" />
        <Label
          id="subtitle"
          translation="[60, 276]"
          width="800"
          height="40"
          horizAlign="center"
          wrap="true"
          maxLines="2"
          text="Enter the playlist credentials to add up in the device." />
      </Group>

      <!--
        Field block height (label 28 + gap 8 + input 64 + field gap 20) = 120 per field.
        4 fields → last input ends at y=428. formRoot + actions leave clear gap.
      -->
      <Group id="formRoot" translation="[0, 328]">
        <Label id="label0" translation="[0, 0]" width="920" height="28" text="Playlist Name" />
        <Poster id="input0Bg" translation="[0, 32]" width="920" height="64" uri="pkg:/images/ui/xtream-input.png" loadDisplayMode="scaleToFit" />
        <Label id="input0" translation="[20, 48]" width="880" height="32" text="Enter Playlist Name" />

        <Label id="label1" translation="[0, 116]" width="920" height="28" text="Server/DNS" />
        <Poster id="input1Bg" translation="[0, 148]" width="920" height="64" uri="pkg:/images/ui/xtream-input.png" loadDisplayMode="scaleToFit" />
        <Label id="input1" translation="[20, 164]" width="880" height="32" text="Enter URL" />

        <Label id="label2" translation="[0, 232]" width="920" height="28" text="Username" />
        <Poster id="input2Bg" translation="[0, 264]" width="920" height="64" uri="pkg:/images/ui/xtream-input.png" loadDisplayMode="scaleToFit" />
        <Label id="input2" translation="[20, 280]" width="880" height="32" text="Enter Username" />

        <Label id="label3" translation="[0, 348]" width="920" height="28" text="Password" />
        <Poster id="input3Bg" translation="[0, 380]" width="920" height="64" uri="pkg:/images/ui/xtream-input.png" loadDisplayMode="scaleToFit" />
        <Label id="input3" translation="[20, 396]" width="880" height="32" text="Enter Password" />
      </Group>

      <Label id="errorLabel" translation="[0, 788]" width="920" height="28" horizAlign="center" visible="false" text="" />

      <!-- Below password (328+444=772) + ~28px gap → 800 -->
      <Group id="actionsRoot" translation="[0, 800]">
        <Group id="cancelBtn" translation="[0, 0]">
          <Poster id="cancelBg" width="440" height="64" uri="pkg:/images/ui/xtream-btn-cancel.png" loadDisplayMode="scaleToFit" />
          <Label id="cancelText" translation="[0, 18]" width="440" height="32" horizAlign="center" text="Cancel" />
        </Group>
        <Group id="confirmBtn" translation="[480, 0]">
          <Poster id="confirmBg" width="440" height="64" uri="pkg:/images/ui/xtream-btn-confirm-disabled.png" loadDisplayMode="scaleToFit" />
          <Label id="confirmText" translation="[0, 18]" width="440" height="32" horizAlign="center" text="Confirm" />
        </Group>
      </Group>
    </Group>

    <Group id="keyboardHeader" translation="[500, 48]" visible="false">
      <Label id="kbFieldLabel" width="920" height="28" text="Playlist Name" />
      <Poster id="kbFieldBg" translation="[0, 36]" width="920" height="64" uri="pkg:/images/ui/xtream-input-kb.png" loadDisplayMode="scaleToFit" />
      <Label id="kbFieldValue" translation="[20, 52]" width="880" height="32" text="" />
    </Group>

    <Group id="keyboardRoot" translation="[500, 560]" visible="false" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/DuplexShared.brs" />
  <script type="text/brightscript" uri="pkg:/source/widgets/DuplexKeyboard.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/XtreamSetupPanel.brs" />
</component>
