<?xml version="1.0" encoding="utf-8" ?>
<component name="VodDetailPanel" extends="Group">
  <interface>
    <field id="item" type="assocarray" />
    <field id="watchSelected" type="assocarray" alwaysNotify="true" />
    <field id="backSelected" type="boolean" alwaysNotify="true" />
    <function name="onPanelShown" />
    <function name="handleKeyEvent" />
  </interface>

  <children>
    <Rectangle id="background" width="1920" height="1080" color="0x141416FF" />
    <Poster id="backdrop" translation="[0, 0]" width="1920" height="1080" loadDisplayMode="scaleToFill" />
    <Rectangle id="dim" width="1920" height="1080" color="0x141416D0" />

    <Group id="hero" translation="[96, 190]">
      <Rectangle id="posterFrame" width="404" height="606" color="0xFFFFFF2E" />
      <Poster id="poster" translation="[2, 2]" width="400" height="600" loadDisplayMode="scaleToZoom" />

      <Group id="copy" translation="[468, 8]">
        <Label id="meta" width="1240" height="36" text="" />
        <Label id="title" translation="[0, 48]" width="1240" height="150" wrap="true" maxLines="2" text="" />

        <Group id="starBadge" translation="[0, 214]">
          <Rectangle width="150" height="36" color="0x3E3420FF" />
          <Label id="starText" translation="[12, 6]" width="126" height="26" text="★  —" />
        </Group>
        <Group id="ageBadge" translation="[166, 214]">
          <Rectangle width="72" height="36" color="0x2A2C32FF" />
          <Label id="ageText" translation="[0, 6]" width="72" height="26" horizAlign="center" text="13+" />
        </Group>

        <Label id="plot" translation="[0, 270]" width="1200" height="190" wrap="true" maxLines="5" text="" />

        <Group id="actions" translation="[0, 478]">
          <Rectangle id="watchRing" translation="[-6, -6]" width="332" height="84" color="0x3B82F6FF" visible="true" />
          <Group id="watchBtn">
            <Rectangle id="watchBg" width="320" height="72" color="0xFFFFFFFF" />
            <Poster id="playIcon" translation="[28, 22]" width="28" height="28" uri="pkg:/images/ui/play-icon.png" />
            <Label id="watchText" translation="[68, 18]" width="230" height="36" text="Watch now" />
          </Group>
          <Poster id="favBg" translation="[344, -4]" width="80" height="80" uri="pkg:/images/ui/hub-util.png" />
          <Poster id="favIcon" translation="[364, 16]" width="40" height="40" uri="pkg:/images/ui/live-heart.png" />
          <Rectangle id="favOn" translation="[400, 0]" width="16" height="16" color="0xE11D48FF" visible="false" />
          <Poster id="lockBg" translation="[440, -4]" width="80" height="80" uri="pkg:/images/ui/hub-util.png" />
          <Poster id="lockIcon" translation="[460, 16]" width="40" height="40" uri="pkg:/images/ui/hub-icon-lock.png" />
          <Rectangle id="lockOn" translation="[496, 0]" width="16" height="16" color="0x0451DFFF" visible="false" />
        </Group>

        <Group id="castRow" translation="[0, 580]">
          <Label id="castLabel" width="90" height="36" text="Cast:" />
          <Label id="castNames" translation="[100, 0]" width="1100" height="36" text="" />
        </Group>
        <Label id="actionStatus" translation="[0, 630]" width="1100" height="36" text="" visible="false" />
      </Group>
    </Group>

    <Group id="loadingOverlay" visible="false">
      <Rectangle width="1920" height="1080" color="0x141416E6" />
      <Group id="detailSkeleton" />
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/DuplexShared.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/VodDetailPanel.brs" />
</component>
