<?xml version="1.0" encoding="utf-8" ?>
<component name="ParentalPinPanel" extends="Group">
  <interface>
    <field id="mode" type="string" value="pin" />
    <field id="unlockedSelected" type="boolean" alwaysNotify="true" />
    <field id="backSelected" type="boolean" alwaysNotify="true" />
    <function name="onPanelShown" />
    <function name="handleKeyEvent" />
  </interface>

  <children>
    <Rectangle id="background" width="1920" height="1080" color="0x000000E6" />
    <Rectangle id="card" translation="[560, 280]" width="800" height="480" color="0x1A1B1FFF" />
    <Label id="title" translation="[560, 320]" width="800" height="48" horizAlign="center" text="Parental Control" />
    <Label id="subtitle" translation="[600, 380]" width="720" height="60" horizAlign="center" wrap="true" maxLines="2" text="Enter your 4-digit PIN" />
    <Label id="pinDisplay" translation="[560, 470]" width="800" height="64" horizAlign="center" text="• • • •" />
    <Label id="status" translation="[600, 560]" width="720" height="40" horizAlign="center" text="" />
    <Label id="hint" translation="[600, 640]" width="720" height="60" horizAlign="center" wrap="true" maxLines="2" text="0–9 enter digits · Backspace left · OK submit · Back cancel" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/DuplexShared.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ParentalPinPanel.brs" />
</component>
