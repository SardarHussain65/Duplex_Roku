<?xml version="1.0" encoding="utf-8" ?>
<component name="SettingsPanel" extends="Group">
  <interface>
    <field id="backSelected" type="boolean" alwaysNotify="true" />
    <field id="logoutSelected" type="boolean" alwaysNotify="true" />
    <field id="playlistSelected" type="assocarray" alwaysNotify="true" />
    <field id="changePinSelected" type="boolean" alwaysNotify="true" />
    <function name="onPanelShown" />
    <function name="handleKeyEvent" />
  </interface>

  <children>
    <Rectangle id="background" width="1920" height="1080" color="0x000000FF" />

    <Group id="sideNav" translation="[64, 56]" />

    <Group id="content" translation="[432, 56]">
      <Group id="head">
        <Label id="panelTitle" width="980" height="52" text="Language" />
        <Label id="panelSub" translation="[0, 56]" width="980" height="36" text="" />
        <Group id="clearHistoryBtn" translation="[1020, 8]" visible="false">
          <Poster id="clearHistoryBg" width="280" height="56" uri="pkg:/images/ui/settings-btn-danger.png" loadDisplayMode="scaleToFill" />
          <Poster id="clearHistoryIcon" translation="[36, 18]" width="20" height="20" uri="pkg:/images/ui/settings-trash.png" loadDisplayMode="scaleToFit" />
          <Label id="clearHistoryText" translation="[64, 0]" width="190" height="56" vertAlign="center" text="Clear All History" />
        </Group>
      </Group>
      <Rectangle id="panelRule" translation="[0, 110]" width="1420" height="1" color="0xFFFFFF1F" />
      <Group id="bodyRoot" translation="[0, 140]" />
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/DuplexShared.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/SettingsPanel.brs" />
</component>
