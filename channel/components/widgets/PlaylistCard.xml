<?xml version="1.0" encoding="utf-8" ?>
<component name="PlaylistCard" extends="Group">
  <interface>
    <field id="cardName" type="string" alias="nameLabel.text" />
    <field id="cardUrl" type="string" alias="urlLabel.text" />
    <field id="cardTag" type="string" alias="tagLabel.text" />
    <field id="cardFocused" type="boolean" onChange="onFocusChanged" />
  </interface>

  <children>
    <!-- Rounded card art (Roku Rectangle cannot round corners) -->
    <Poster id="cardArt" width="720" height="100" uri="pkg:/images/ui/playlist-card.png" loadDisplayMode="scaleToFit" />

    <Poster id="iconChip" translation="[22, 26]" width="48" height="48" uri="pkg:/images/ui/playlist-icon-chip.png" loadDisplayMode="scaleToFit" />
    <Label id="iconGlyph" translation="[30, 32]" width="32" height="36" horizAlign="center" text="≡" />

    <Label id="nameLabel" translation="[86, 22]" width="440" height="32" text="" />
    <Label id="urlLabel" translation="[86, 54]" width="480" height="28" text="" />

    <Poster id="tagBg" translation="[555, 12]" width="150" height="28" uri="pkg:/images/ui/playlist-tag.png" loadDisplayMode="scaleToFit" />
    <Label id="tagGlyph" translation="[565, 14]" width="18" height="24" text="☰" />
    <Label id="tagLabel" translation="[584, 16]" width="112" height="22" text="" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/widgets/PlaylistCard.brs" />
</component>
